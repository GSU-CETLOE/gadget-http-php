{
  "name": "gsu-cetloe/gadget-http-php",
  "description": "Gadget library for working with HTTP",
  "type": "library",
  "keywords": [],
  "homepage": "https://github.com/GSU-CETLOE/gadget-http-php",
  "license": "MIT",
  "authors": [
    {
      "name": "Jeb Barger",
      "role": "Application Developer"
    }
  ],
  "require": {
    "php": "8.1.*",
    "gsu-cetloe/gadget-cache-php": "^1.0",
    "gsu-cetloe/gadget-core-php": "^1.0",
    "gsu-cetloe/symfony-bundle": "^1.0",
    "guzzlehttp/guzzle": "^7.9",
    "guzzlehttp/psr7": "^2.7",
    "php-http/discovery": "^1.19",
    "psr/http-client": "^1.0",
    "psr/http-factory": "^1.1",
    "psr/http-message": "^2.0",
    "psr/http-server-handler": "^1.0",
    "psr/http-server-middleware": "^1.0"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.0",
    "phpstan/phpstan-strict-rules": "^2.0",
    "phpstan/extension-installer": "^1.4",
    "phpunit/phpunit": "^10.5",
    "squizlabs/php_codesniffer": "^3.10",
    "symfony/cache": "6.4.*"
  },
  "autoload": {
    "psr-4": {
      "Gadget\\Http\\": ["src/", "bundle/"]
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Gadget\\Http\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "phpstan/extension-installer": true,
      "php-http/discovery": true
    },
    "platform": {
      "php": "8.1.0"
    },
    "sort-packages": true,
    "optimize-autoloader": true,
    "apcu-autoloader": true
  },
  "scripts": {
    "phpcs": "vendor/bin/phpcs",
    "phpstan": "vendor/bin/phpstan analyse -c phpstan.neon",
    "test": "vendor/bin/phpunit",
    "check": [
      "@phpcs",
      "@phpstan",
      "@test"
    ]
  }
}
